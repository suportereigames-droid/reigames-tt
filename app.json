{
  "expo": {
    "name": "REI GAMES",
    "slug": "tt-reigames",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tt-reigames",
    "android": {
      "package": "br.com.reigames.tt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1115"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E7B94C"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "42c51c07-25a9-4450-8ecb-16dd58d1f838"
      }
    }
  }
}
